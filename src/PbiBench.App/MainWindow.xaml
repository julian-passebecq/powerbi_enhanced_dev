<Window x:Class="PbiBench.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PbiBench" Width="1540" Height="940" MinWidth="1050" MinHeight="650" Background="#F7F8F6" FontFamily="Segoe UI" FontSize="13" Closing="WindowClosing" PreviewKeyDown="WindowKeyDown" UseLayoutRounding="True" Icon="Assets/PbiBench.ico">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition Height="*" MinHeight="320"/><RowDefinition x:Name="OutputSplitterRow" Height="5"/><RowDefinition x:Name="OutputRow" Height="125"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="144"/><ColumnDefinition Width="*" MinWidth="600"/><ColumnDefinition x:Name="InspectorSplitterColumn" Width="5"/><ColumnDefinition x:Name="InspectorColumn" Width="250"/></Grid.ColumnDefinitions>
  <Border Grid.ColumnSpan="4" Background="White" BorderBrush="#DDE1E6" BorderThickness="0,0,0,1" Padding="20,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="144"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="PbiBench" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock x:Name="ModelTitle" Text="Home" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ConnectionStatus" Text="Open a project or connect a model" Foreground="#626B78" Margin="0,4,0,4"/><TextBlock x:Name="ProjectContextStrip" Text="No project" Foreground="#626B78" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="2" Margin="16,0,0,0" MaxWidth="320"><TextBlock x:Name="GitHeader" Text="Git · no project" Foreground="#626B78" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ValidationStatus" Text="Ready" Foreground="#315DA8" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border>
  <Border Grid.Row="1" Grid.RowSpan="3" Background="#EEF2F3" BorderBrush="#D8E0E3" BorderThickness="0,0,1,0"><DockPanel Margin="10,16"><TextBlock DockPanel.Dock="Top" Text="WORKSPACES" FontSize="10" FontWeight="Bold" Margin="10,0,0,14"/><TextBlock DockPanel.Dock="Bottom" Text="Ctrl+K · Commands" FontSize="10" Foreground="#607782" Margin="8"/><ListBox x:Name="Navigation" SelectionChanged="NavigationChanged" BorderThickness="0" Background="Transparent" SelectedIndex="0"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="4,10"/><Setter Property="Margin" Value="0,1"/></Style></ListBox.ItemContainerStyle><ListBoxItem Content="Home"/><ListBoxItem Content="Model"/><ListBoxItem Content="DAX"/><ListBoxItem Content="Automate"/><ListBoxItem Content="Report"/><ListBoxItem Content="Project"/><ListBoxItem Content="Fabric"/><ListBoxItem Content="Tools"/><ListBoxItem Content="Settings"/><ListBoxItem Content="About"/></ListBox></DockPanel></Border>
  <Grid Grid.Row="1" Grid.Column="1" Margin="14,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <WrapPanel x:Name="PrimaryCommands"><Button Content="Open…" Tag="Open" Click="CommandClick"/><Button Content="Connect…" Tag="Connect" Click="CommandClick"/><Button Content="Save" Tag="Save" Click="CommandClick"/><Button Content="Undo" Tag="Undo" Click="CommandClick"/><Button Content="Redo" Tag="Redo" Click="CommandClick"/><Button Content="BPA" Tag="RunBpa" Click="CommandClick"/><Button Content="Automate" Tag="Automate" Click="CommandClick"/><Button Content="DAX Studio" Tag="DaxStudio" Click="CommandClick"/><Button Content="Advanced TE2 ▾" Click="ToggleLegacy"/><Button Content="Inspector" Click="ToggleInspector"/><Button Content="Output" Click="ToggleOutput"/></WrapPanel>
   <WrapPanel x:Name="SecondaryCommands" Grid.Row="1"><Button Content="Model tools" Click="OpenAuthoring"/><Button Content="Data" Click="OpenDataArea"/><Button Content="Semantic View" Tag="Diagram" Click="CommandClick"/><Button Content="Quality" Click="OpenQualityArea"/><Button Content="Fabric model source" Click="OpenFabricAuthoring"/><Button Content="Design Exchange" Click="OpenDesignExchange"/></WrapPanel>
   <Grid Grid.Row="2">
    <ContentControl x:Name="ModelSurface"/>
    <ScrollViewer x:Name="HomePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="16,8,16,24"><TextBlock Text="Welcome to PbiBench" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Build your model, review your reports, and keep the project together." Foreground="#626B78" Margin="0,8,0,24"/>
<TextBlock Text="Continue" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/><WrapPanel><Button Content="Open PBIP project…" Click="ChooseWorkspace"/><Button Content="Open model…" Tag="Open" Click="CommandClick"/><Button Content="Connect…" Tag="Connect" Click="CommandClick"/><Button Content="Explore demo" Click="OpenDemo"/></WrapPanel><TextBlock x:Name="RecentEmpty" Text="Your recent projects, models and reports appear here." Foreground="#626B78"/><ListBox x:Name="RecentProjects" BorderThickness="0" Background="Transparent" MouseDoubleClick="OpenRecent" KeyDown="RecentKeyDown" MaxHeight="100"/><StackPanel x:Name="HomeCards"/></StackPanel></ScrollViewer>
    <ContentControl x:Name="DesignExchangeSurface" Visibility="Collapsed"/>
    <Grid x:Name="DaxPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="DAX Workbench" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="DaxHandoffDetails" Text="Write, run and inspect everyday DAX here. Analyze deep performance in external DAX Studio." TextWrapping="Wrap" Margin="0,6,0,12"/></StackPanel><WrapPanel Grid.Row="1"><Button Content="Use active expression" Click="UseExpression"/><Button Content="Configure DAX Studio…" Click="ConfigureDaxStudio"/></WrapPanel><ContentControl x:Name="DaxWorkspaceSurface" Grid.Row="2"/></Grid>
    <Grid x:Name="AutomationPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Automation Gallery" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="SelectionSummary" TextWrapping="Wrap" Margin="0,6,0,12"/></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="205" MinWidth="175"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="285"/></Grid.ColumnDefinitions>
<ListBox x:Name="ActionPicker" SelectionChanged="GallerySelectionChanged" SelectedIndex="0" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6,9"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Selection}" FontSize="11" Foreground="#607782" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
<Grid Grid.Column="2" Margin="12,0,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="145"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="GalleryTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="GalleryDetails" TextWrapping="Wrap" Margin="0,8"/><TextBlock x:Name="GalleryRisk" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/><WrapPanel><StackPanel Margin="0,0,8,8"><TextBlock Text="Measure table" FontSize="11"/><TextBox x:Name="MeasureTableName" Text="_Measures" Width="120" Padding="5"/></StackPanel><StackPanel><TextBlock Text="Display folder" FontSize="11"/><TextBox x:Name="DisplayFolderName" Text="Business metrics" Width="145" Padding="5"/></StackPanel></WrapPanel><CheckBox x:Name="AllMeasures" Content="Use all measures for this action" Margin="0,7,0,10"/><WrapPanel><Button Content="Scan objects" Click="ScanAction"/><Button x:Name="PreviewActionButton" Content="Review &amp; apply…" Click="PreviewAction" IsEnabled="False"/><Button Content="Undo" Tag="Undo" Click="CommandClick"/><Button Content="Accept result" Click="AcceptAutomation"/></WrapPanel><TextBlock x:Name="AutomationResult" Text="1 Scan · 2 Review · 3 Apply · 4 Validate" TextWrapping="Wrap" Margin="0,4,0,10"/></StackPanel></ScrollViewer><DataGrid x:Name="ActionPreviewGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Object" Binding="{Binding ObjectPath}" Width="2*"/><DataGridTextColumn Header="Property" Binding="{Binding Property}" Width="*"/><DataGridTextColumn Header="Before" Binding="{Binding Before}" Width="2*"/><DataGridTextColumn Header="After" Binding="{Binding After}" Width="2*"/></DataGrid.Columns></DataGrid></Grid></Grid></Grid>
    <ContentControl x:Name="AuthoringPage" Visibility="Collapsed"/><ContentControl x:Name="DataPage" Visibility="Collapsed"/><ContentControl x:Name="DiagramPage" Visibility="Collapsed"/>
    <Grid x:Name="WorkspacePage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><TextBlock Text="PBIP / Git" FontSize="25" FontWeight="SemiBold" Margin="0,0,25,14"/><Button Content="Choose workspace…" Click="ChooseWorkspace"/><Button Content="Refresh status" Click="RefreshWorkspace"/><Button Content="Design Exchange" Click="OpenDesignExchange"/></WrapPanel><TextBlock x:Name="WorkspaceDetails" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,14"/><TabControl Grid.Row="2"><TabItem Header="Changed files"><DataGrid x:Name="GitFiles"><DataGrid.Columns><DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="90"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="60"/><DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*"/><DataGridTextColumn Header="Previous path" Binding="{Binding OriginalPath}" Width="*"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="Status details"><TextBox x:Name="GitDetails" IsReadOnly="True" FontFamily="Consolas" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12" Background="White"/></TabItem></TabControl></Grid>
    <Grid x:Name="QaPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel><TextBlock Text="Quality / BPA" FontSize="25" FontWeight="SemiBold" Margin="0,0,24,14"/><Button Content="Scan model" Click="ScanBpa"/><Button Content="Full TE2 BPA…" Click="NativeBpa"/><Button Content="Preview selected fix…" Click="PreviewBpaFix"/><Button Content="Go to object" Click="GoToFinding"/><Button Content="Ignore / restore" Click="IgnoreFinding"/><ComboBox x:Name="BpaSeverity" Width="115" SelectedIndex="0" SelectionChanged="FilterBpa" Margin="0,0,8,8"><ComboBoxItem Content="All severities"/><ComboBoxItem Content="Error"/><ComboBoxItem Content="Warning"/><ComboBoxItem Content="Information"/></ComboBox><ComboBox x:Name="BpaCategory" Width="130" SelectedIndex="0" SelectionChanged="FilterBpa" Margin="0,0,8,8"><ComboBoxItem Content="All categories"/><ComboBoxItem Content="Documentation"/><ComboBoxItem Content="Organization"/><ComboBoxItem Content="Modeling"/><ComboBoxItem Content="DAX"/></ComboBox><CheckBox x:Name="ShowIgnored" Content="Show ignored" Checked="FilterBpa" Unchecked="FilterBpa" Margin="0,5,0,8"/></WrapPanel><DataGrid x:Name="BpaGrid" Grid.Row="1" SelectionChanged="BpaSelectionChanged" MouseDoubleClick="NavigateBpa"><DataGrid.Columns><DataGridTextColumn Header="Risk" Binding="{Binding Risk}" Width="100"/><DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="85"/><DataGridTextColumn Header="Object" Binding="{Binding ObjectPath}" Width="2*"/><DataGridTextColumn Header="Rule" Binding="{Binding Rule}" Width="2*"/></DataGrid.Columns></DataGrid><TextBox x:Name="FindingDetails" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200" VerticalScrollBarVisibility="Auto" Background="#EEF3F4" BorderThickness="0" Padding="14" Margin="0,12,0,0"/></Grid>
    <StackPanel x:Name="LaterPage" Visibility="Collapsed" Margin="24"><TextBlock x:Name="LaterTitle" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="LaterDetails" TextWrapping="Wrap" Margin="0,18"/></StackPanel>
   </Grid>
  </Grid>
  <GridSplitter x:Name="InspectorSplitter" Grid.Row="1" Grid.Column="2" Width="5" HorizontalAlignment="Stretch" Background="#E0E6E8"/>
<Border x:Name="InspectorPane" Grid.Row="1" Grid.Column="3" Background="White" BorderBrush="#D8E0E3" BorderThickness="1,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14,16"><TextBlock Text="INSPECTOR" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="InspectorTitle" Text="No selection" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,4"/><TextBlock x:Name="InspectorSelection" Text="Select in the model tree" TextWrapping="Wrap" FontSize="11"/><ItemsControl x:Name="InspectorFields" Margin="0,14,0,4"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,10"><TextBlock Text="{Binding Label}" FontSize="10" Foreground="#607782"/><TextBlock Text="{Binding Value}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBox x:Name="InspectorExpression" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="110" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Background="#F7F8F6" BorderThickness="0" Padding="6"/><WrapPanel x:Name="InspectorActions" Margin="0,10,0,0"/><Expander Header="Session &amp; tools" Margin="0,12,0,0"><StackPanel><TextBlock x:Name="InspectorModel" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10"/><TextBlock x:Name="InspectorDetails" TextWrapping="Wrap" FontSize="11"/><TextBlock x:Name="DaxStudioStatus" TextWrapping="Wrap" FontSize="11" Margin="0,12"/><TextBlock x:Name="SourceStatus" TextWrapping="Wrap" FontSize="11"/></StackPanel></Expander></StackPanel></ScrollViewer></Border>
<GridSplitter x:Name="OutputSplitter" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#E0E6E8"/><TabControl x:Name="OutputTabs" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Background="#F7F8F6" BorderBrush="#D8E0E3"><TabItem Header="Output"><TextBox x:Name="Output" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="11" Padding="10"/></TabItem><TabItem Header="Action history"><ListBox x:Name="ActionHistory" BorderThickness="0" FontFamily="Consolas" FontSize="11" Padding="8"/></TabItem><TabItem Header="Validation"><TextBox x:Name="ValidationDetails" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Padding="10" VerticalScrollBarVisibility="Auto" Text="Run BPA or scan an automation action to review model findings."/></TabItem></TabControl>
 </Grid>
</Window>
