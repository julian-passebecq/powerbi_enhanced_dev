<Window x:Class="PbiBench.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PbiBench — Model workbench" Width="1540" Height="940" MinWidth="1050" MinHeight="650" Background="#F7F8F6" FontFamily="Segoe UI" FontSize="13" Closing="WindowClosing" PreviewKeyDown="WindowKeyDown">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,6"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CCD6DB"/><Setter Property="Foreground" Value="#173C52"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#223D4C"/></Style>
  <Style TargetType="DataGrid"><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="BorderBrush" Value="#D8E0E3"/><Setter Property="MinRowHeight" Value="34"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="125"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="174"/><ColumnDefinition Width="*"/><ColumnDefinition Width="245"/></Grid.ColumnDefinitions>
  <Border Grid.ColumnSpan="3" Background="#173C52" Padding="20,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="154"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PbiBench" FontSize="22" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="ENGINEERING WORKBENCH" FontSize="9" Foreground="#E4C956"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="ModelTitle" Text="Open a semantic model" FontSize="18" Foreground="White"/><TextBlock x:Name="ConnectionStatus" Text="Local files · Desktop / XMLA" Foreground="#DAE6EC" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Name="GitHeader" Text="Git · no project" Foreground="#DAE6EC"/><TextBlock x:Name="ValidationStatus" Text="Ready" Foreground="#E4C956" Margin="0,7,0,0"/></StackPanel></Grid></Border>
  <Border Grid.Row="1" Grid.RowSpan="2" Background="#EEF2F3" BorderBrush="#D8E0E3" BorderThickness="0,0,1,0"><DockPanel Margin="10,16"><TextBlock DockPanel.Dock="Top" Text="WORKBENCH" FontSize="10" FontWeight="Bold" Margin="10,0,0,14"/><TextBlock DockPanel.Dock="Bottom" Text="TE2 2.28.0 foundation&#x0a;Integrated Model Editor&#x0a;Ctrl+K · Commands" FontSize="10" Foreground="#607782" Margin="8"/><ListBox x:Name="Navigation" SelectionChanged="NavigationChanged" BorderThickness="0" Background="Transparent" SelectedIndex="1"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,1"/></Style></ListBox.ItemContainerStyle><ListBoxItem Content="Home"/><ListBoxItem Content="Model"/><ListBoxItem Content="DAX"/><ListBoxItem Content="Automate"/><ListBoxItem Content="Model diagram"/><ListBoxItem Content="PBIP / Git"/><ListBoxItem Content="QA"/><ListBoxItem Content="Report"/><ListBoxItem Content="Fabric"/><ListBoxItem Content="Deploy"/><ListBoxItem Content="Knowledge"/><ListBoxItem Content="Agent"/></ListBox></DockPanel></Border>
  <Grid Grid.Row="1" Grid.Column="1" Margin="14,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <WrapPanel><Button Content="Open model…" Click="OpenModel"/><Button Content="Connect…" Click="ConnectModel"/><Button Content="Save" Click="SaveModel"/><Button Content="Undo" Click="Undo"/><Button Content="Redo" Click="Redo"/><Button Content="Demo model" Click="OpenDemo"/><Button Content="Expression → DAX Studio" Click="LaunchActiveExpression"/></WrapPanel>
   <Grid Grid.Row="1">
    <ContentControl x:Name="ModelSurface"/>
    <ScrollViewer x:Name="HomePage" Visibility="Collapsed"><StackPanel Margin="24"><TextBlock Text="Your semantic engineering workspace" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Open a BIM, PBIP, PBIT or TMDL model, or connect to Power BI Desktop / XMLA." Margin="0,16" TextWrapping="Wrap"/><Button Content="Explore the demo model" Click="OpenDemo" HorizontalAlignment="Left"/><TextBlock Text="Model" FontSize="20" Margin="0,25,0,8"/><TextBlock Text="The integrated TE2 editor keeps the model tree, property grid, expressions, dependencies, translations, perspectives, C# scripting and undo history together." TextWrapping="Wrap"/><TextBlock Text="Preview your changes" FontSize="20" Margin="0,25,0,8"/><TextBlock Text="Select objects in Model, then open Automate to inspect exact changes before applying them. QA adds explained findings and conservative fixes. The model diagram links back to the editor." TextWrapping="Wrap"/></StackPanel></ScrollViewer>
    <Grid x:Name="DaxPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="DAX scratch query" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Local syntax highlighting and formatting · deep profiling opens DAX Studio" Margin="0,6,0,12"/></StackPanel><WrapPanel Grid.Row="1"><Button Content="Use active expression" Click="UseExpression"/><Button Content="Format query" Click="FormatScratch"/><Button Content="Save .dax…" Click="SaveScratch"/><Button Content="Open in DAX Studio" Click="LaunchDaxStudio"/><Button Content="Configure DAX Studio…" Click="ConfigureDaxStudio"/></WrapPanel><ContentControl x:Name="ScratchSurface" Grid.Row="2"/></Grid>
    <Grid x:Name="AutomationPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Automate model work" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="SelectionSummary" Text="Select columns or measures in Model first." TextWrapping="Wrap" Margin="0,8,0,15"/></StackPanel><StackPanel Grid.Row="1"><ComboBox x:Name="ActionPicker" DisplayMemberPath="Name" SelectedIndex="0" Margin="0,0,0,12" Padding="8"/><WrapPanel><TextBlock Text="Table" VerticalAlignment="Center" Margin="0,0,8,8"/><TextBox x:Name="MeasureTableName" Text="_Measures" Width="140" Margin="0,0,16,8" Padding="5"/><TextBlock Text="Folder" VerticalAlignment="Center" Margin="0,0,8,8"/><TextBox x:Name="DisplayFolderName" Text="Business metrics" Width="170" Margin="0,0,8,8" Padding="5"/></WrapPanel><WrapPanel><CheckBox x:Name="AllMeasures" Content="Use all measures (format / folders / descriptions)" Margin="0,7,15,12"/><Button Content="Preview affected objects…" Click="PreviewAction"/></WrapPanel></StackPanel><DataGrid x:Name="ActionPreviewGrid" Grid.Row="2"><DataGrid.Columns><DataGridTextColumn Header="Object" Binding="{Binding ObjectPath}" Width="2*"/><DataGridTextColumn Header="Property" Binding="{Binding Property}" Width="*"/><DataGridTextColumn Header="Before" Binding="{Binding Before}" Width="2*"/><DataGridTextColumn Header="After" Binding="{Binding After}" Width="2*"/></DataGrid.Columns></DataGrid></Grid>
    <DockPanel x:Name="DiagramPage" Visibility="Collapsed"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Model relationships" FontSize="25" FontWeight="SemiBold"/><WrapPanel Margin="0,8"><TextBlock Text="Blue: fact · Gold: dimension · Solid: active · Dashed: inactive · Arrows: filters" TextWrapping="Wrap"/><Button Content="Refresh diagram" Click="RefreshDiagram" Margin="12,0"/></WrapPanel></StackPanel><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Canvas x:Name="DiagramCanvas" Background="#F7F8F6"/></ScrollViewer></DockPanel>
    <Grid x:Name="WorkspacePage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><TextBlock Text="PBIP / Git" FontSize="25" FontWeight="SemiBold" Margin="0,0,25,14"/><Button Content="Choose workspace…" Click="ChooseWorkspace"/><Button Content="Refresh status" Click="RefreshWorkspace"/></WrapPanel><TextBlock x:Name="WorkspaceDetails" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,14"/><TextBox x:Name="GitDetails" Grid.Row="2" IsReadOnly="True" FontFamily="Consolas" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12" Background="White"/></Grid>
    <Grid x:Name="QaPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel><TextBlock Text="Quality / BPA" FontSize="25" FontWeight="SemiBold" Margin="0,0,24,14"/><Button Content="Scan model" Click="ScanBpa"/><Button Content="Full TE2 BPA…" Click="NativeBpa"/><Button Content="Preview selected fix…" Click="PreviewBpaFix"/></WrapPanel><DataGrid x:Name="BpaGrid" Grid.Row="1" SelectionChanged="BpaSelectionChanged" MouseDoubleClick="NavigateBpa"><DataGrid.Columns><DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="85"/><DataGridTextColumn Header="Object" Binding="{Binding ObjectPath}" Width="2*"/><DataGridTextColumn Header="Rule" Binding="{Binding Rule}" Width="2*"/></DataGrid.Columns></DataGrid><TextBox x:Name="FindingDetails" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200" VerticalScrollBarVisibility="Auto" Background="#EEF3F4" BorderThickness="0" Padding="14" Margin="0,12,0,0"/></Grid>
    <StackPanel x:Name="LaterPage" Visibility="Collapsed" Margin="24"><TextBlock x:Name="LaterTitle" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="LaterDetails" TextWrapping="Wrap" Margin="0,18"/></StackPanel>
   </Grid>
  </Grid>
  <Border Grid.Row="1" Grid.Column="2" Background="White" BorderBrush="#D8E0E3" BorderThickness="1,0,0,0"><ScrollViewer><StackPanel Margin="17,22"><TextBlock Text="SESSION" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="InspectorModel" Text="No model loaded" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12"/><TextBlock x:Name="InspectorDetails" TextWrapping="Wrap"/><Separator Margin="0,18"/><TextBlock Text="SELECTED OBJECTS" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="InspectorSelection" Text="Select in the model tree" TextWrapping="Wrap" Margin="0,10"/><Separator Margin="0,18"/><TextBlock Text="SPECIALIST TOOLS" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="DaxStudioStatus" Text="DAX Studio · configure in DAX" TextWrapping="Wrap" Margin="0,10"/><Separator Margin="0,18"/><TextBlock Text="SOURCE" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="SourceStatus" Text="No PBIP workspace" TextWrapping="Wrap" Margin="0,10"/></StackPanel></ScrollViewer></Border>
  <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Background="#EDF1F3" BorderBrush="#D8E0E3" BorderThickness="0,1,0,0"><DockPanel Margin="14,8"><TextBlock DockPanel.Dock="Top" Text="OUTPUT / VALIDATION" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/><TextBox x:Name="Output" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="11"/></DockPanel></Border>
 </Grid>
</Window>
