<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net48</TargetFramework><UseWPF>true</UseWPF>
    <Version>2.3.0</Version><AssemblyName>PbiBench</AssemblyName><AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/PbiBench.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PbiBench.Pbir/PbiBench.Pbir.csproj" />
    <ProjectReference Include="../PbiBench.CSharp.LanguageService/PbiBench.CSharp.LanguageService.csproj" />
    <Reference Include="FastColoredTextBox"><HintPath>../../vendor/TabularEditor2-2.28.0/packages/FCTB.2.16.24/lib/FastColoredTextBox.dll</HintPath></Reference>
    <Reference Include="TOMWrapper"><HintPath>../../vendor/TabularEditor2-2.28.0/TOMWrapper/bin/$(Configuration)/TOMWrapper.dll</HintPath></Reference>
    <Reference Include="Microsoft.AnalysisServices.Tabular"><HintPath>../../vendor/TabularEditor2-2.28.0/TabularEditor/bin/$(Configuration)/Microsoft.AnalysisServices.Tabular.dll</HintPath></Reference>
    <Reference Include="Microsoft.AnalysisServices.Core"><HintPath>../../vendor/TabularEditor2-2.28.0/TabularEditor/bin/$(Configuration)/Microsoft.AnalysisServices.Core.dll</HintPath></Reference>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="WindowsFormsIntegration" />
    <ProjectReference Include="../PbiBench.Core/PbiBench.Core.csproj" />
    <ProjectReference Include="../PbiBench.ModelEditor/PbiBench.ModelEditor.csproj" />
    <ProjectReference Include="../PbiBench.Workspace/PbiBench.Workspace.csproj" />
    <ProjectReference Include="../PbiBench.Git/PbiBench.Git.csproj" />
    <ProjectReference Include="../PbiBench.DaxStudio/PbiBench.DaxStudio.csproj" />
    <ProjectReference Include="../PbiBench.Automation/PbiBench.Automation.csproj" />
    <ProjectReference Include="../PbiBench.Fabric/PbiBench.Fabric.csproj" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup><None Include="../../examples/pass1-demo.bim" Link="examples/pass1-demo.bim" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><None Include="../../examples/reportstudio-demo/**/*" Link="examples/reportstudio-demo/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><None Include="../../examples/prototypes/**/*" Link="examples/prototypes/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/PbiBench.ico" /></ItemGroup>
  <ItemGroup><None Include="../../docs/architecture/**/*" Link="docs/architecture/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <Target Name="CopyTe2Runtime" AfterTargets="Build">
    <ItemGroup><Te2Runtime Include="../../vendor/TabularEditor2-2.28.0/TabularEditor/bin/$(Configuration)/**/*" Exclude="../../vendor/TabularEditor2-2.28.0/TabularEditor/bin/$(Configuration)/**/*.pdb;../../vendor/TabularEditor2-2.28.0/TabularEditor/bin/$(Configuration)/**/*.config" /></ItemGroup>
    <Copy SourceFiles="@(Te2Runtime)" DestinationFiles="@(Te2Runtime->'$(TargetDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="!Exists('$(TargetDir)%(Te2Runtime.RecursiveDir)%(Te2Runtime.Filename)%(Te2Runtime.Extension)')" />
  </Target>
<ItemGroup><ProjectReference Include="../PbiBench.DesignSystem/PbiBench.DesignSystem.csproj" /><ProjectReference Include="../PbiBench.DesignExchange/PbiBench.DesignExchange.csproj" /><ProjectReference Include="../PbiBench.ExternalTools/PbiBench.ExternalTools.csproj" /></ItemGroup></Project>
