+        private void RestoreFunctionIndex()
+        {
+            // Public TOM has no positional Insert, and removed metadata cannot be reattached.
+            // Renew only the affected suffix through the existing Undelete path, preserving
+            // wrapper identities and all serialized properties. Other object kinds are unchanged.
+            if (_functionIndex < 0 || !(_obj is Function)) return;
+            var functions = (FunctionCollection)_collection;
+            var position = functions.IndexOf((Function)_obj);
+            if (position <= _functionIndex) return;
+            var suffix = new[] { (Function)_obj }.Concat(functions.Skip(_functionIndex).Where(item => !ReferenceEquals(item, _obj)))
+                .Select(item => new { Object = item, Json = Microsoft.AnalysisServices.Tabular.JsonSerializer.SerializeObject(
+                    item.MetadataObject, TabularObject.RenewMetadataOptions, item.Handler.CompatibilityLevel, item.Handler.Database.CompatibilityMode) }).ToArray();
+            foreach (var item in suffix) _collection.Remove(item.Object);
+            foreach (var item in suffix) item.Object.Undelete(_collection, _tomObjectType, item.Json);
+        }
