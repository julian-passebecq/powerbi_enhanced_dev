diff --git a/TOMWrapperTest/RemoteWriteReviewTests.cs b/TOMWrapperTest/RemoteWriteReviewTests.cs
new file mode 100644
index 0000000..3cf3519
--- /dev/null
+++ b/TOMWrapperTest/RemoteWriteReviewTests.cs
@@ -0,0 +1,76 @@
+using System;
+using System.Reflection;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using TabularEditor.TOMWrapper;
+using TabularEditor.TOMWrapper.Utils;
+using TOM = Microsoft.AnalysisServices.Tabular;
+
+namespace TOMWrapperTest
+{
+    [TestClass]
+    public class RemoteWriteReviewTests
+    {
+        [TestMethod]
+        public void RefusedDeploymentDoesNotExecuteOrRecordTmsl()
+        {
+            var deployer = new TabularDeployer { ReviewRemoteWrite = (_, __, ___) => false };
+            var executed = false;
+            Assert.ThrowsException<OperationCanceledException>(() => deployer.ExecuteReviewed("server/database", "{\"createOrReplace\":{}}", () => { executed = true; return null; }));
+            Assert.IsFalse(executed);
+            Assert.IsNull(deployer.LastExecutedTmsl);
+        }
+
+        [TestMethod]
+        public void ApprovedDeploymentReceivesExactProposedContext()
+        {
+            const string tmsl = "{\"createOrReplace\":{\"database\":{\"name\":\"Test\"}}}";
+            var reviewed = false;
+            var executed = false;
+            var deployer = new TabularDeployer { ReviewRemoteWrite = (operation, target, proposed) => {
+                Assert.AreEqual("Deploy semantic model", operation);
+                Assert.AreEqual("server/Test", target);
+                Assert.AreEqual(tmsl, proposed);
+                reviewed = true;
+                return true;
+            }};
+            deployer.ExecuteReviewed("server/Test", tmsl, () => { Assert.IsTrue(reviewed); executed = true; return null; });
+            Assert.IsTrue(executed);
+            Assert.AreEqual(tmsl, deployer.LastExecutedTmsl);
+        }
+
+        [TestMethod]
+        public void UnconfiguredDeployerRetainsUpstreamExecution()
+        {
+            var deployer = new TabularDeployer();
+            var executed = false;
+            deployer.ExecuteReviewed("server/Test", "{}", () => { executed = true; return null; });
+            Assert.IsTrue(executed);
+        }
+
+        [TestMethod]
+        public void RefusedSaveStopsBeforeConnectionAndRetainsUndo()
+        {
+            var handler = new TabularModelHandler();
+            handler.Model.AddTable("Sales").AddMeasure("Amount", "1 + 2");
+            var undoSteps = handler.UndoManager.UndoSteps;
+            // An unconnected TOM server supplies object parentage only; no connection is made.
+            using (var server = new TOM.Server())
+            {
+                server.Databases.Add(handler.Database);
+                typeof(TabularModelHandler).GetProperty("Version").SetValue(handler, 1L);
+                var reviewed = false;
+                handler.ReviewRemoteWrite = (operation, target, proposed) => {
+                    Assert.AreEqual("Save semantic model", operation);
+                    StringAssert.Contains(proposed, "Sales");
+                    StringAssert.Contains(proposed, "1 + 2");
+                    reviewed = true;
+                    return false;
+                };
+                Assert.ThrowsException<OperationCanceledException>(() => handler.SaveDB());
+                Assert.IsTrue(reviewed);
+                Assert.AreEqual(undoSteps, handler.UndoManager.UndoSteps);
+                Assert.IsFalse(server.Connected);
+            }
+        }
+    }
+}
